# ===============================================
# CONFIGURACIÓN DE MANTENIMIENTO - AlbinoL
# ===============================================
# 
# INSTRUCCIONES DE USO:
# 1. Para ACTIVAR el modo mantenimiento: descomenta las líneas del bloque "MODO MANTENIMIENTO ACTIVO"
# 2. Para DESACTIVAR el modo mantenimiento: comenta las líneas del bloque "MODO MANTENIMIENTO ACTIVO"
# 3. Cambia la IP en la línea "RewriteCond %{REMOTE_ADDR} !^190\.23\.45\.67$" por tu IP real
#
# ===============================================

# Configuración básica de Apache
RewriteEngine On

# ===============================================
# MODO MANTENIMIENTO ACTIVO
# ===============================================
# Descomenta las siguientes líneas para activar el modo mantenimiento
# Comenta las siguientes líneas para desactivar el modo mantenimiento

# Excluir la IP del administrador (cambiar por tu IP real)
# RewriteCond %{REMOTE_ADDR} !^190\.2\.96\.145$

# Excluir la página de mantenimiento para evitar bucles infinitos
# RewriteCond %{REQUEST_URI} !^/maintenance\.html$

# Excluir recursos estáticos de la página de mantenimiento
# RewriteCond %{REQUEST_URI} !^/assets/images/logo\.png$
# RewriteCond %{REQUEST_URI} !^/assets/css/.*$
# RewriteCond %{REQUEST_URI} !^/assets/js/.*$
# RewriteCond %{REQUEST_URI} !^/assets/videos/.*$

# Excluir archivos del sistema que podrían ser necesarios
# RewriteCond %{REQUEST_URI} !^/favicon\.ico$
# RewriteCond %{REQUEST_URI} !^/robots\.txt$
# RewriteCond %{REQUEST_URI} !^/sitemap\.xml$

# Redirigir todo el tráfico a la página de mantenimiento
# RewriteRule ^(.*)$ /maintenance.html [R=302,L]

# ===============================================
# CONFIGURACIÓN NORMAL DEL SITIO (cuando NO está en mantenimiento)
# ===============================================

# Forzar recarga del .htaccess (temporal)
# RewriteRule ^reload$ - [E=reload:1]

# Redirección de la página principal
RewriteRule ^$ index.php [L]

# Forzar HTTPS (opcional)
# RewriteCond %{HTTPS} off
# RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# URLs amigables para páginas principales
RewriteRule ^agricultura/?$ pages/agricultura.php [L,QSA]
RewriteRule ^ganaderia/?$ pages/ganaderia.php [L,QSA]
RewriteRule ^nosotros/?$ pages/nosotros.php [L,QSA]
RewriteRule ^contacto/?$ pages/contacto.php [L,QSA]

# Redirección de archivos PHP en la raíz (solo si no existe en la raíz)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^([^/]+)\.php$ pages/$1.php [L]

# Redirección de URLs con .php a URLs amigables (opcional - para SEO)
RewriteCond %{THE_REQUEST} /pages/([^/]+)\.php[\s?] [NC]
RewriteRule ^pages/([^/]+)\.php$ /%1? [R=301,L]

# Manejo de errores 404
ErrorDocument 404 /404.php

# Configuración de seguridad
# Ocultar archivos sensibles
<Files "composer.json">
    Order Allow,Deny
    Deny from all
</Files>

<Files "*.log">
    Order Allow,Deny
    Deny from all
</Files>

<FilesMatch "\.(htaccess|htpasswd|ini|log|sh|inc|bak)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# Proteger directorios sensibles
RedirectMatch 403 ^/includes/.*\.(log|txt)$
RedirectMatch 403 ^/logs/.*$

# Configuración de caché para recursos estáticos
<IfModule mod_expires.c>
    ExpiresActive On
    
    # Imágenes (1 año)
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/ico "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    
    # CSS y JavaScript (1 mes)
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType application/x-javascript "access plus 1 month"
    
    # Fuentes (1 año)
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/ttf "access plus 1 year"
    ExpiresByType font/otf "access plus 1 year"
    ExpiresByType application/font-woff2 "access plus 1 year"
    ExpiresByType application/font-woff "access plus 1 year"
    
    # Videos (1 mes)
    ExpiresByType video/mp4 "access plus 1 month"
    ExpiresByType video/webm "access plus 1 month"
    ExpiresByType video/ogg "access plus 1 month"
    
    # Documentos (1 mes)
    ExpiresByType application/pdf "access plus 1 month"
    
    # HTML (1 día para evitar obsolescencia)
    ExpiresByType text/html "access plus 1 day"
    
    # JSON y XML (1 semana)
    ExpiresByType application/json "access plus 1 week"
    ExpiresByType application/xml "access plus 1 week"
    ExpiresByType text/xml "access plus 1 week"
</IfModule>

# Cache-Control headers para recursos estáticos
<IfModule mod_headers.c>
    # Recursos estáticos con versionado (1 año)
    <FilesMatch "\.(jpg|jpeg|png|gif|webp|svg|ico|woff2|woff|ttf|otf)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    
    # CSS y JS con versionado (1 mes)
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
    
    # Videos (1 mes)
    <FilesMatch "\.(mp4|webm|ogg)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
    
    # HTML (1 día)
    <FilesMatch "\.(html|htm|php)$">
        Header set Cache-Control "public, max-age=86400"
    </FilesMatch>
    
    # JSON y XML (1 semana)
    <FilesMatch "\.(json|xml)$">
        Header set Cache-Control "public, max-age=604800"
    </FilesMatch>
</IfModule>

# Compresión GZIP
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
</IfModule>

# Configuración de headers de seguridad
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options nosniff
    Header always set X-Frame-Options DENY
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Página de error personalizada
ErrorDocument 404 /404.php

# ===============================================
# NOTAS IMPORTANTES:
# ===============================================
# 1. Para activar mantenimiento: descomenta la línea "RewriteRule ^(.*)$ /maintenance.html [R=302,L]"
# 2. Para desactivar mantenimiento: comenta la línea "RewriteRule ^(.*)$ /maintenance.html [R=302,L]"
# 3. Cambia "190.23.45.67" por tu IP real para poder acceder al sitio durante el mantenimiento
# 4. La IP debe estar en formato CIDR si necesitas rangos (ej: 190.23.45.0/24)
# 5. Puedes agregar múltiples IPs duplicando la línea RewriteCond con diferentes IPs
# ===============================================