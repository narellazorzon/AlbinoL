# ===============================================
# CONFIGURACIÓN DE MANTENIMIENTO - AlbinoL
# ===============================================
# 
# INSTRUCCIONES DE USO:
# 1. Para ACTIVAR el modo mantenimiento: descomenta las líneas del bloque "MODO MANTENIMIENTO ACTIVO"
# 2. Para DESACTIVAR el modo mantenimiento: comenta las líneas del bloque "MODO MANTENIMIENTO ACTIVO"
# 3. Cambia la IP en la línea "RewriteCond %{REMOTE_ADDR} !^190\.23\.45\.67$" por tu IP real
#
# ===============================================

# ===============================================
# OPTIMIZACIÓN DE RENDIMIENTO - Document Request Latency
# ===============================================

# Configuración básica de Apache
RewriteEngine On

# ===============================================
# REDIRECCIONES OPTIMIZADAS (Una sola redirección limpia)
# ===============================================
# Redirección HTTP → HTTPS y WWW → sin WWW en una sola regla
# Solo aplica en producción (no en localhost)
RewriteCond %{HTTP_HOST} !^localhost [NC]
RewriteCond %{HTTP_HOST} !^127\.0\.0\.1 [NC]
RewriteCond %{HTTP_HOST} !^192\.168\. [NC]
RewriteCond %{HTTP_HOST} !^10\. [NC]
RewriteCond %{HTTP_HOST} !^172\.(1[6-9]|2[0-9]|3[0-1])\. [NC]
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\.(.*)$ [NC]
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# ===============================================
# MODO MANTENIMIENTO ACTIVO
# ===============================================
# Descomenta las siguientes líneas para activar el modo mantenimiento
# Comenta las siguientes líneas para desactivar el modo mantenimiento

# Excluir la IP del administrador (cambiar por tu IP real)
# RewriteCond %{REMOTE_ADDR} !^190\.23\.45\.67$

# Excluir la página de mantenimiento para evitar bucles infinitos
# RewriteCond %{REQUEST_URI} !^/maintenance\.html$

# Excluir recursos estáticos de la página de mantenimiento
# RewriteCond %{REQUEST_URI} !^/assets/images/logo\.png$
# RewriteCond %{REQUEST_URI} !^/assets/css/.*$
# RewriteCond %{REQUEST_URI} !^/assets/js/.*$
# RewriteCond %{REQUEST_URI} !^/assets/videos/.*$

# Excluir archivos del sistema que podrían ser necesarios
# RewriteCond %{REQUEST_URI} !^/favicon\.ico$
# RewriteCond %{REQUEST_URI} !^/robots\.txt$
# RewriteCond %{REQUEST_URI} !^/sitemap\.xml$

# Redirigir todo el tráfico a la página de mantenimiento
# RewriteRule ^(.*)$ /maintenance.html [R=302,L]

# ===============================================
# CONFIGURACIÓN PARA DESARROLLO LOCAL
# ===============================================
# Desactiva optimizaciones que pueden causar problemas en localhost
<IfModule mod_headers.c>
    # Solo en localhost, desactiva algunos headers de seguridad
    RewriteCond %{HTTP_HOST} ^localhost [NC,OR]
    RewriteCond %{HTTP_HOST} ^127\.0\.0\.1 [NC,OR]
    RewriteCond %{HTTP_HOST} ^192\.168\. [NC,OR]
    RewriteCond %{HTTP_HOST} ^10\. [NC,OR]
    RewriteCond %{HTTP_HOST} ^172\.(1[6-9]|2[0-9]|3[0-1])\. [NC]
    RewriteRule ^(.*)$ - [E=LOCALHOST:1]
</IfModule>

# ===============================================
# CONFIGURACIÓN NORMAL DEL SITIO (cuando NO está en mantenimiento)
# ===============================================

# Redirección de la página principal
RewriteRule ^$ index.php [L]

# Redirección de páginas sin .php
RewriteRule ^agricultura/?$ pages/agricultura.php [L]
RewriteRule ^ganaderia/?$ pages/ganaderia.php [L]
RewriteRule ^nosotros/?$ pages/nosotros.php [L]
RewriteRule ^contacto/?$ pages/contacto.php [L]

# Redirección de archivos PHP en la raíz (solo si no existe en la raíz)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^([^/]+)\.php$ pages/$1.php [L]

# Configuración de seguridad
# Ocultar archivos sensibles
<Files "composer.json">
    Order Allow,Deny
    Deny from all
</Files>

<Files "*.log">
    Order Allow,Deny
    Deny from all
</Files>

<FilesMatch "\.(htaccess|htpasswd|ini|log|sh|inc|bak)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# Proteger directorios sensibles
RedirectMatch 403 ^/includes/.*\.(log|txt)$
RedirectMatch 403 ^/logs/.*$

# ===============================================
# CACHÉ OPTIMIZADO PARA MÓVIL (Document Request Latency)
# ===============================================
# Configuración de caché agresiva para reducir latencia en móviles
<IfModule mod_expires.c>
    ExpiresActive On
    
    # HTML crítico (1 hora para balance entre performance y actualizaciones)
    ExpiresByType text/html "access plus 1 hour"
    
    # CSS y JS críticos (7 días - balance óptimo para móviles)
    ExpiresByType text/css "access plus 7 days"
    ExpiresByType text/javascript "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
    ExpiresByType application/x-javascript "access plus 7 days"
    
    # Imágenes optimizadas (30 días para móviles)
    ExpiresByType image/webp "access plus 30 days"
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/jpg "access plus 30 days"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/gif "access plus 30 days"
    ExpiresByType image/svg+xml "access plus 30 days"
    ExpiresByType image/ico "access plus 30 days"
    ExpiresByType image/x-icon "access plus 30 days"
    
    # Fuentes web (1 año - raramente cambian)
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/ttf "access plus 1 year"
    ExpiresByType font/otf "access plus 1 year"
    ExpiresByType application/font-woff2 "access plus 1 year"
    ExpiresByType application/font-woff "access plus 1 year"
    
    # Videos (7 días - balance para móviles)
    ExpiresByType video/mp4 "access plus 7 days"
    ExpiresByType video/webm "access plus 7 days"
    ExpiresByType video/ogg "access plus 7 days"
    
    # JSON y XML (1 semana)
    ExpiresByType application/json "access plus 1 week"
    ExpiresByType application/xml "access plus 1 week"
    ExpiresByType text/xml "access plus 1 week"
    
    # Default para otros archivos
    ExpiresDefault "access plus 1 hour"
</IfModule>

# Cache-Control headers para recursos estáticos
<IfModule mod_headers.c>
    # Recursos estáticos con versionado (1 año)
    <FilesMatch "\.(jpg|jpeg|png|gif|webp|svg|ico|woff2|woff|ttf|otf)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    
    # CSS y JS con versionado (1 mes)
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
    
    # Videos (1 mes)
    <FilesMatch "\.(mp4|webm|ogg)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
    
    # HTML (1 día)
    <FilesMatch "\.(html|htm|php)$">
        Header set Cache-Control "public, max-age=86400"
    </FilesMatch>
    
    # JSON y XML (1 semana)
    <FilesMatch "\.(json|xml)$">
        Header set Cache-Control "public, max-age=604800"
    </FilesMatch>
</IfModule>

# ===============================================
# COMPRESIÓN OPTIMIZADA (GZIP + Brotli si está disponible)
# ===============================================
# Compresión GZIP optimizada para reducir Document Request Latency
<IfModule mod_deflate.c>
    # HTML, CSS, JS críticos
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
    AddOutputFilterByType DEFLATE application/json
    
    # XML y RSS
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/atom+xml
    
    # Fuentes web
    AddOutputFilterByType DEFLATE font/woff2
    AddOutputFilterByType DEFLATE font/woff
    AddOutputFilterByType DEFLATE application/font-woff2
    AddOutputFilterByType DEFLATE application/font-woff
    
    # SVG (texto)
    AddOutputFilterByType DEFLATE image/svg+xml
    
    # Excluir archivos ya comprimidos
    SetEnvIfNoCase Request_URI \
        \.(?:gif|jpe?g|png|zip|gz|bz2|sit|rar|7z)$ no-gzip dont-vary
    SetEnvIfNoCase Request_URI \
        \.(?:exe|t?gz|zip|bz2|sit|rar|7z)$ no-gzip dont-vary
</IfModule>

# Compresión Brotli (si está disponible)
<IfModule mod_brotli.c>
    AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/javascript application/javascript application/json
    AddOutputFilterByType BROTLI_COMPRESS text/xml application/xml application/xhtml+xml application/rss+xml
    AddOutputFilterByType BROTLI_COMPRESS font/woff2 font/woff application/font-woff2 application/font-woff
    AddOutputFilterByType BROTLI_COMPRESS image/svg+xml
</IfModule>

# ===============================================
# HEADERS DE SEGURIDAD (Solo en producción)
# ===============================================
# Headers de seguridad que solo se aplican en producción
<IfModule mod_headers.c>
    # Solo aplicar headers de seguridad si NO es localhost
    RewriteCond %{HTTP_HOST} !^localhost [NC]
    RewriteCond %{HTTP_HOST} !^127\.0\.0\.1 [NC]
    RewriteCond %{HTTP_HOST} !^192\.168\. [NC]
    RewriteCond %{HTTP_HOST} !^10\. [NC]
    RewriteCond %{HTTP_HOST} !^172\.(1[6-9]|2[0-9]|3[0-1])\. [NC]
    RewriteRule ^(.*)$ - [E=PRODUCTION:1]
    
    # Headers de seguridad solo en producción
    Header always set X-Content-Type-Options nosniff env=PRODUCTION
    Header always set X-Frame-Options DENY env=PRODUCTION
    Header always set X-XSS-Protection "1; mode=block" env=PRODUCTION
    Header always set Referrer-Policy "strict-origin-when-cross-origin" env=PRODUCTION
</IfModule>

# Página de error personalizada
ErrorDocument 404 /404.php

# ===============================================
# NOTAS IMPORTANTES:
# ===============================================
# 1. Para activar mantenimiento: descomenta la línea "RewriteRule ^(.*)$ /maintenance.html [R=302,L]"
# 2. Para desactivar mantenimiento: comenta la línea "RewriteRule ^(.*)$ /maintenance.html [R=302,L]"
# 3. Cambia "190.23.45.67" por tu IP real para poder acceder al sitio durante el mantenimiento
# 4. La IP debe estar en formato CIDR si necesitas rangos (ej: 190.23.45.0/24)
# 5. Puedes agregar múltiples IPs duplicando la línea RewriteCond con diferentes IPs
# ===============================================