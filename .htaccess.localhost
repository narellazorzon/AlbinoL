# ===============================================
# CONFIGURACIÓN PARA DESARROLLO LOCAL (XAMPP)
# ===============================================
# 
# INSTRUCCIONES:
# 1. Renombra este archivo a .htaccess cuando trabajes en localhost
# 2. Renombra de vuelta a .htaccess.localhost cuando subas a producción
# 3. O simplemente usa este archivo en localhost
#
# ===============================================

# Configuración básica de Apache
RewriteEngine On

# ===============================================
# CONFIGURACIÓN PARA DESARROLLO LOCAL
# ===============================================
# Sin redirecciones HTTPS en localhost
# Sin headers de seguridad estrictos
# Con compresión habilitada para testing

# Redirección de la página principal
RewriteRule ^$ index.php [L]

# Redirección de páginas sin .php
RewriteRule ^agricultura/?$ pages/agricultura.php [L]
RewriteRule ^ganaderia/?$ pages/ganaderia.php [L]
RewriteRule ^nosotros/?$ pages/nosotros.php [L]
RewriteRule ^contacto/?$ pages/contacto.php [L]

# Redirección de archivos PHP en la raíz (solo si no existe en la raíz)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^([^/]+)\.php$ pages/$1.php [L]

# ===============================================
# CONFIGURACIÓN DE SEGURIDAD BÁSICA
# ===============================================
# Ocultar archivos sensibles
<Files "composer.json">
    Order Allow,Deny
    Deny from all
</Files>

<Files "*.log">
    Order Allow,Deny
    Deny from all
</Files>

<FilesMatch "\.(htaccess|htpasswd|ini|log|sh|inc|bak)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# Proteger directorios sensibles
RedirectMatch 403 ^/includes/.*\.(log|txt)$
RedirectMatch 403 ^/logs/.*$

# ===============================================
# CACHÉ BÁSICO PARA DESARROLLO
# ===============================================
<IfModule mod_expires.c>
    ExpiresActive On
    
    # HTML (sin caché para desarrollo)
    ExpiresByType text/html "access plus 0 seconds"
    
    # CSS y JS (caché corto para desarrollo)
    ExpiresByType text/css "access plus 1 hour"
    ExpiresByType text/javascript "access plus 1 hour"
    ExpiresByType application/javascript "access plus 1 hour"
    
    # Imágenes (caché corto para desarrollo)
    ExpiresByType image/webp "access plus 1 hour"
    ExpiresByType image/jpeg "access plus 1 hour"
    ExpiresByType image/png "access plus 1 hour"
    ExpiresByType image/gif "access plus 1 hour"
    ExpiresByType image/svg+xml "access plus 1 hour"
    
    # Videos (caché corto para desarrollo)
    ExpiresByType video/mp4 "access plus 1 hour"
    ExpiresByType video/webm "access plus 1 hour"
</IfModule>

# ===============================================
# COMPRESIÓN BÁSICA PARA DESARROLLO
# ===============================================
<IfModule mod_deflate.c>
    # Compresión básica para desarrollo
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/json
</IfModule>

# Página de error personalizada
ErrorDocument 404 /404.php

# ===============================================
# NOTAS PARA DESARROLLO:
# ===============================================
# 1. Este archivo está optimizado para desarrollo local
# 2. No incluye redirecciones HTTPS (evita errores de certificado)
# 3. Caché reducido para ver cambios inmediatamente
# 4. Compresión básica para testing de performance
# 5. Headers de seguridad relajados para desarrollo
# ===============================================
